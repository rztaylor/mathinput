{
  "name": "@mathinput/core",
  "version": "0.1.0",
  "description": "Expression tree, headless editor, serialisers and parsers for MathInput. No DOM.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rztaylor/mathinput.git",
    "directory": "packages/core"
  },
  "homepage": "https://mathinput.rztaylor.uk",
  "bugs": "https://github.com/rztaylor/mathinput/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/copy-license.mjs",
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "publishConfig": {
    "access": "public"
  }
}
