{
  "name": "mathinput-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/element",
    "packages/react",
    "packages/presets-uk",
    "site"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:katex": "vitest run packages/core/tests/golden/katex.test.ts",
    "build": "npm run build -w @mathinput/core -w @mathinput/element -w @mathinput/react -w @mathinput/presets-uk",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:browser": "npm run test:browser -w @mathinput/element",
    "dev": "npm run dev -w @mathinput/element",
    "size": "node scripts/size.mjs",
    "site": "npm run dev -w @mathinput/site",
    "build:site": "npm run build -w @mathinput/site",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/stix-two-text": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "katex": "^0.18.9",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
